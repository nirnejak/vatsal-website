{
  "name": "vatsal-website",
  "version": "1.0.0",
  "description": "Personal website of Vatsal Dhameliya, a machine learning scientist.",
  "keywords": [
    "nextjs",
    "oxfmt",
    "oxlint",
    "precommit",
    "react",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/nirnejak/vatsal-website/issues"
  },
  "license": "MIT",
  "author": "Jitendra Nirnejak <jeetnirnejak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirnejak/vatsal-website"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --pretty --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "@shikijs/rehype": "^4.6.0",
    "akar-icons": "^1.9.31",
    "katex": "^0.16.21",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "next-view-transitions": "^0.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md}": "oxfmt"
  },
  "volta": {
    "node": "24.12.0"
  },
  "packageManager": "bun@1.4.0"
}
